{
  "name": "physics-problem-simulator",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": { "node": ">=26 <27", "pnpm": ">=12 <13" },
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "tsc -b && vp build",
    "preview": "vp preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1", "three": "0.187.0" },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite-plus": "1.6.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  }
}
